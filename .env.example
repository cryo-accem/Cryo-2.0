DATABASE_URL= 
# Verify the MySQL server certificate (recommended for Aiven). Set ONE of:
#   MYSQL_SSL_CA      path to the provider CA file (e.g. Aiven's ca.pem)
#   MYSQL_SSL_CA_PEM  the CA certificate contents (multi-line, or with \n escapes)
# If neither is set, TLS is used without certificate verification and a warning is logged.
MYSQL_SSL_CA=
MYSQL_SSL_CA_PEM=
# Optional: fixed temporary password for the local SQLite preview admin
# (otherwise a random one is generated and logged). Never used with MySQL.
PREVIEW_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=convenor
BOOTSTRAP_ADMIN_EMAIL=cryoem.iisc@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
SECRET_KEY=
# Create a Deepgram key for hosted voice transcription and spoken answers; keep it secret.
DEEPGRAM_API_KEY=
SECURE_COOKIES=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CHARGE_SHEET_CC_EMAIL=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
FREEZING_REMINDER_EMAIL=cryoem.iisc@gmail.com
GITHUB_TOKEN=
GITHUB_REPOSITORY=cryo-accem/Cryo-2.0
GITHUB_BRANCH=main
